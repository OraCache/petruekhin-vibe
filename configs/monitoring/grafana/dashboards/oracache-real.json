{
  "uid": "oracache-real-cluster",
  "title": "OraCache · Реальный кластер",
  "schemaVersion": 41,
  "refresh": "5s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "links": [
    {
      "type": "link",
      "title": "← MVP под нагрузкой",
      "url": "/d/oracache-mvp",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Storage-нода",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "oracache-prometheus"
        },
        "definition": "label_values(up{job=\"storage-node\"}, instance)",
        "query": {
          "query": "label_values(up{job=\"storage-node\"}, instance)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Доступность и Control Plane",
      "gridPos": {"x":0,"y":0,"w":24,"h":1},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Цели сбора",
      "description": "Доступность HTTP scrape по каждой из пяти целей.",
      "gridPos": {"x":0,"y":1,"w":12,"h":7},
      "datasource": {"type":"prometheus","uid":"oracache-prometheus"},
      "fieldConfig": {"defaults":{"unit":"none","noValue":"Нет данных","mappings":[{"type":"value","options":{"0":{"text":"Недоступен","color":"red"},"1":{"text":"Доступен","color":"green"}}}]},"overrides":[]},
      "options": {"reduceOptions":{"calcs":["lastNotNull"]},"textMode":"value_and_name","colorMode":"value"},
      "targets": [
        {"refId":"A","expr":"up{job=~\"cp-api|api-gateway|storage-node\",instance=~\"${node:regex}|api-gateway:9466|cp-api:9464\"}","legendFormat":"{{job}} · {{instance}}","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":true,"range":false}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Связь Gateway с CP",
      "description": "Секунды с последнего принятого ответа. Ответ с той же ревизией обновляет отметку.",
      "gridPos": {"x":12,"y":1,"w":12,"h":7},
      "datasource": {"type":"prometheus","uid":"oracache-prometheus"},
      "fieldConfig": {"defaults":{"unit":"s","noValue":"Нет данных","custom":{"spanNulls":false}},"overrides":[]},
      "options": {"legend":{"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "targets": [
        {"refId":"A","expr":"time() - oracache_gateway_config_last_success_timestamp_seconds","legendFormat":"{{job}} · {{instance}}","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Обновления карты Gateway",
      "description": "Результаты обновления карты за последнюю минуту.",
      "gridPos": {"x":0,"y":8,"w":12,"h":7},
      "datasource": {"type":"prometheus","uid":"oracache-prometheus"},
      "fieldConfig": {"defaults":{"unit":"short","noValue":"Нет данных","custom":{"spanNulls":false}},"overrides":[]},
      "options": {"legend":{"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "targets": [
        {"refId":"A","expr":"increase(oracache_gateway_config_refresh_total[1m])","legendFormat":"{{result}} · {{instance}}","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true}
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Партиции без маршрута",
      "description": "Ноль означает полное покрытие принятой картой. До первой карты серии отсутствуют.",
      "gridPos": {"x":12,"y":8,"w":12,"h":7},
      "datasource": {"type":"prometheus","uid":"oracache-prometheus"},
      "fieldConfig": {"defaults":{"unit":"short","noValue":"Нет данных","custom":{"spanNulls":false}},"overrides":[]},
      "options": {"legend":{"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "targets": [
        {"refId":"A","expr":"oracache_gateway_partitions_without_route","legendFormat":"{{operation}} · {{instance}}","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Возраст heartbeat",
      "description": "Секунды с момента приёма CP последнего heartbeat от настроенной ноды.",
      "gridPos": {"x":0,"y":15,"w":12,"h":7},
      "datasource": {"type":"prometheus","uid":"oracache-prometheus"},
      "fieldConfig": {"defaults":{"unit":"s","noValue":"Нет данных","custom":{"spanNulls":false}},"overrides":[]},
      "options": {"legend":{"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "targets": [
        {"refId":"A","expr":"oracache_cp_heartbeat_age_seconds","legendFormat":"{{region}} · {{node_id}}","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Ноды в последнем представлении CP",
      "description": "Количество нод по состояниям последнего представления CP.",
      "gridPos": {"x":12,"y":15,"w":12,"h":7},
      "datasource": {"type":"prometheus","uid":"oracache-prometheus"},
      "fieldConfig": {"defaults":{"unit":"short","noValue":"Нет данных","custom":{"spanNulls":false}},"overrides":[]},
      "options": {"legend":{"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "targets": [
        {"refId":"A","expr":"oracache_cp_live_nodes","legendFormat":"{{state}}","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true}
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Ревизии конфигурации",
      "description": "Смена лидера может происходить при той же ревизии.",
      "gridPos": {"x":0,"y":22,"w":12,"h":7},
      "datasource": {"type":"prometheus","uid":"oracache-prometheus"},
      "fieldConfig": {"defaults":{"unit":"short","noValue":"Нет данных","custom":{"spanNulls":false}},"overrides":[]},
      "options": {"legend":{"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "targets": [
        {"refId":"A","expr":"oracache_cp_config_revision","legendFormat":"CP","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true},
        {"refId":"B","expr":"oracache_gateway_config_revision","legendFormat":"Gateway","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true}
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Длительность RPC Control Plane",
      "description": "Перцентили времени ReportHeartbeat и GetConfig за минуту.",
      "gridPos": {"x":12,"y":22,"w":12,"h":7},
      "datasource": {"type":"prometheus","uid":"oracache-prometheus"},
      "fieldConfig": {"defaults":{"unit":"s","noValue":"Нет данных","custom":{"spanNulls":false}},"overrides":[]},
      "options": {"legend":{"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "targets": [
        {"refId":"A","expr":"histogram_quantile(0.5, sum by (operation, le) (rate(oracache_cp_rpc_duration_seconds_bucket[1m])))","legendFormat":"{{operation}} · p50","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true},
        {"refId":"B","expr":"histogram_quantile(0.95, sum by (operation, le) (rate(oracache_cp_rpc_duration_seconds_bucket[1m])))","legendFormat":"{{operation}} · p95","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true},
        {"refId":"C","expr":"histogram_quantile(0.99, sum by (operation, le) (rate(oracache_cp_rpc_duration_seconds_bucket[1m])))","legendFormat":"{{operation}} · p99","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true}
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Клиентские RPC и пересылка",
      "gridPos": {"x":0,"y":29,"w":24,"h":1},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Запросы в секунду",
      "description": "Обработанные GET, PUT и DELETE на каждом слое. Storage суммирует реплики.",
      "gridPos": {"x":0,"y":30,"w":12,"h":7},
      "datasource": {"type":"prometheus","uid":"oracache-prometheus"},
      "fieldConfig": {"defaults":{"unit":"reqps","noValue":"Нет данных","custom":{"spanNulls":false}},"overrides":[]},
      "options": {"legend":{"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "targets": [
        {"refId":"A","expr":"sum by (job, operation) (rate(oracache_cache_rpc_total{job=~\"api-gateway|storage-node\",instance=~\"${node:regex}|api-gateway:9466|cp-api:9464\"}[1m]))","legendFormat":"{{job}} · {{operation}}","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true}
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Доменные исходы и коды gRPC",
      "description": "Доменный MISS, конфликт и отсутствие записи при удалении приходят с кодом OK.",
      "gridPos": {"x":12,"y":30,"w":12,"h":7},
      "datasource": {"type":"prometheus","uid":"oracache-prometheus"},
      "fieldConfig": {"defaults":{"unit":"reqps","noValue":"Нет данных","custom":{"spanNulls":false}},"overrides":[]},
      "options": {"legend":{"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "targets": [
        {"refId":"A","expr":"sum by (job, operation, outcome, grpc_code) (rate(oracache_cache_rpc_total{job=~\"api-gateway|storage-node\",instance=~\"${node:regex}|api-gateway:9466|cp-api:9464\"}[1m])) > 0","legendFormat":"{{job}} · {{operation}} · {{outcome}} · {{grpc_code}}","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true}
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Задержка Gateway",
      "description": "Время обработчика Gateway включает маршрутизацию, пересылку и фактические повторы.",
      "gridPos": {"x":0,"y":37,"w":12,"h":7},
      "datasource": {"type":"prometheus","uid":"oracache-prometheus"},
      "fieldConfig": {"defaults":{"unit":"s","noValue":"Нет данных","custom":{"spanNulls":false}},"overrides":[]},
      "options": {"legend":{"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "targets": [
        {"refId":"A","expr":"histogram_quantile(0.5, sum by (operation, le) (rate(oracache_cache_rpc_duration_seconds_bucket{job=\"api-gateway\"}[1m])))","legendFormat":"{{operation}} · p50","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true},
        {"refId":"B","expr":"histogram_quantile(0.95, sum by (operation, le) (rate(oracache_cache_rpc_duration_seconds_bucket{job=\"api-gateway\"}[1m])))","legendFormat":"{{operation}} · p95","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true},
        {"refId":"C","expr":"histogram_quantile(0.99, sum by (operation, le) (rate(oracache_cache_rpc_duration_seconds_bucket{job=\"api-gateway\"}[1m])))","legendFormat":"{{operation}} · p99","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true}
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Задержка Storage Node",
      "description": "Время обработчика включает локальный Raft-путь. Перцентили агрегируются по репликам.",
      "gridPos": {"x":12,"y":37,"w":12,"h":7},
      "datasource": {"type":"prometheus","uid":"oracache-prometheus"},
      "fieldConfig": {"defaults":{"unit":"s","noValue":"Нет данных","custom":{"spanNulls":false}},"overrides":[]},
      "options": {"legend":{"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "targets": [
        {"refId":"A","expr":"histogram_quantile(0.5, sum by (operation, le) (rate(oracache_cache_rpc_duration_seconds_bucket{job=\"storage-node\",instance=~\"${node:regex}\"}[1m])))","legendFormat":"{{operation}} · p50","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true},
        {"refId":"B","expr":"histogram_quantile(0.95, sum by (operation, le) (rate(oracache_cache_rpc_duration_seconds_bucket{job=\"storage-node\",instance=~\"${node:regex}\"}[1m])))","legendFormat":"{{operation}} · p95","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true},
        {"refId":"C","expr":"histogram_quantile(0.99, sum by (operation, le) (rate(oracache_cache_rpc_duration_seconds_bucket{job=\"storage-node\",instance=~\"${node:regex}\"}[1m])))","legendFormat":"{{operation}} · p99","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true}
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Доля gRPC-ошибок",
      "description": "Доля вызовов с кодом gRPC, отличным от OK. Без трафика доля не определена.",
      "gridPos": {"x":0,"y":44,"w":12,"h":7},
      "datasource": {"type":"prometheus","uid":"oracache-prometheus"},
      "fieldConfig": {"defaults":{"unit":"percentunit","noValue":"Нет данных","custom":{"spanNulls":false}},"overrides":[]},
      "options": {"legend":{"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "targets": [
        {"refId":"A","expr":"(sum by (job, operation) (rate(oracache_cache_rpc_total{job=~\"api-gateway|storage-node\",instance=~\"${node:regex}|api-gateway:9466|cp-api:9464\",grpc_code!=\"OK\"}[1m])) or (0 * sum by (job, operation) (rate(oracache_cache_rpc_total{job=~\"api-gateway|storage-node\",instance=~\"${node:regex}|api-gateway:9466|cp-api:9464\"}[1m])))) / (sum by (job, operation) (rate(oracache_cache_rpc_total{job=~\"api-gateway|storage-node\",instance=~\"${node:regex}|api-gateway:9466|cp-api:9464\"}[1m])) > 0)","legendFormat":"{{job}} · {{operation}}","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true}
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Доля попаданий GET",
      "description": "HIT среди HIT, MISS и VERSION_NOT_FOUND с кодом OK.",
      "gridPos": {"x":12,"y":44,"w":12,"h":7},
      "datasource": {"type":"prometheus","uid":"oracache-prometheus"},
      "fieldConfig": {"defaults":{"unit":"percentunit","noValue":"Нет данных","custom":{"spanNulls":false}},"overrides":[]},
      "options": {"legend":{"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "targets": [
        {"refId":"A","expr":"(sum by (job) (rate(oracache_cache_rpc_total{job=~\"api-gateway|storage-node\",instance=~\"${node:regex}|api-gateway:9466|cp-api:9464\",operation=\"get\",grpc_code=\"OK\",outcome=\"hit\"}[1m])) or (0 * sum by (job) (rate(oracache_cache_rpc_total{job=~\"api-gateway|storage-node\",instance=~\"${node:regex}|api-gateway:9466|cp-api:9464\",operation=\"get\",grpc_code=\"OK\",outcome=~\"hit|miss|version_not_found\"}[1m])))) / (sum by (job) (rate(oracache_cache_rpc_total{job=~\"api-gateway|storage-node\",instance=~\"${node:regex}|api-gateway:9466|cp-api:9464\",operation=\"get\",grpc_code=\"OK\",outcome=~\"hit|miss|version_not_found\"}[1m])) > 0)","legendFormat":"{{job}}","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true}
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Пересылка Gateway",
      "description": "Начатые исходящие RPC в секунду. Причина not_leader означает отправленную повторную попытку.",
      "gridPos": {"x":0,"y":51,"w":12,"h":7},
      "datasource": {"type":"prometheus","uid":"oracache-prometheus"},
      "fieldConfig": {"defaults":{"unit":"reqps","noValue":"Нет данных","custom":{"spanNulls":false}},"overrides":[]},
      "options": {"legend":{"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "targets": [
        {"refId":"A","expr":"sum by (operation, reason) (rate(oracache_gateway_forward_attempts_total[1m]))","legendFormat":"{{operation}} · {{reason}}","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true}
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Ошибки отправки Raft",
      "description": "Ошибки отправки сообщений Raft по репликам за минуту.",
      "gridPos": {"x":12,"y":51,"w":12,"h":7},
      "datasource": {"type":"prometheus","uid":"oracache-prometheus"},
      "fieldConfig": {"defaults":{"unit":"short","noValue":"Нет данных","custom":{"spanNulls":false}},"overrides":[]},
      "options": {"legend":{"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "targets": [
        {"refId":"A","expr":"increase(oracache_raft_transport_send_errors_total{instance=~\"${node:regex}\"}[1m])","legendFormat":"{{region}} / {{partition}} · {{node_id}}","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true}
      ]
    },
    {
      "id": 19,
      "type": "row",
      "title": "Реплики Raft",
      "gridPos": {"x":0,"y":58,"w":24,"h":1},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Лидер, известное лидерство и Ready",
      "description": "Локальные признаки из снимка каждой реплики. Доступность записи проверяется клиентским PUT.",
      "gridPos": {"x":0,"y":59,"w":12,"h":7},
      "datasource": {"type":"prometheus","uid":"oracache-prometheus"},
      "fieldConfig": {"defaults":{"unit":"short","noValue":"Нет данных","custom":{"spanNulls":false}},"overrides":[]},
      "options": {"legend":{"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "targets": [
        {"refId":"A","expr":"oracache_raft_is_leader{instance=~\"${node:regex}\"}","legendFormat":"лидер · {{region}} / {{partition}} · {{node_id}}","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true},
        {"refId":"B","expr":"oracache_raft_is_follower{instance=~\"${node:regex}\"}","legendFormat":"follower · {{region}} / {{partition}} · {{node_id}}","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true},
        {"refId":"C","expr":"oracache_raft_has_leader{instance=~\"${node:regex}\"}","legendFormat":"знает лидера · {{region}} / {{partition}} · {{node_id}}","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true},
        {"refId":"D","expr":"oracache_raft_ready{instance=~\"${node:regex}\"}","legendFormat":"готова · {{region}} / {{partition}} · {{node_id}}","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true}
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Raft term",
      "description": "Текущий терм каждой реплики.",
      "gridPos": {"x":12,"y":59,"w":12,"h":7},
      "datasource": {"type":"prometheus","uid":"oracache-prometheus"},
      "fieldConfig": {"defaults":{"unit":"short","noValue":"Нет данных","custom":{"spanNulls":false}},"overrides":[]},
      "options": {"legend":{"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "targets": [
        {"refId":"A","expr":"oracache_raft_term{instance=~\"${node:regex}\"}","legendFormat":"{{region}} / {{partition}} · {{node_id}}","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true}
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Индексы реплик",
      "description": "Конец локального лога включает незакоммиченные записи. Snapshot index равен нулю до первого снапшота.",
      "gridPos": {"x":0,"y":66,"w":12,"h":7},
      "datasource": {"type":"prometheus","uid":"oracache-prometheus"},
      "fieldConfig": {"defaults":{"unit":"short","noValue":"Нет данных","custom":{"spanNulls":false}},"overrides":[]},
      "options": {"legend":{"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "targets": [
        {"refId":"A","expr":"oracache_raft_commit_index{instance=~\"${node:regex}\"}","legendFormat":"commit · {{region}} / {{partition}} · {{node_id}}","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true},
        {"refId":"B","expr":"oracache_raft_applied_index{instance=~\"${node:regex}\"}","legendFormat":"applied · {{region}} / {{partition}} · {{node_id}}","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true},
        {"refId":"C","expr":"oracache_raft_snapshot_index{instance=~\"${node:regex}\"}","legendFormat":"snapshot · {{region}} / {{partition}} · {{node_id}}","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true},
        {"refId":"D","expr":"oracache_raft_last_index{instance=~\"${node:regex}\"}","legendFormat":"last · {{region}} / {{partition}} · {{node_id}}","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true}
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Очередь применения",
      "description": "Локальный commit_index минус локальный applied_index, в записях лога.",
      "gridPos": {"x":12,"y":66,"w":12,"h":7},
      "datasource": {"type":"prometheus","uid":"oracache-prometheus"},
      "fieldConfig": {"defaults":{"unit":"short","noValue":"Нет данных","custom":{"spanNulls":false}},"overrides":[]},
      "options": {"legend":{"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "targets": [
        {"refId":"A","expr":"oracache_raft_commit_index{instance=~\"${node:regex}\"} - oracache_raft_applied_index{instance=~\"${node:regex}\"}","legendFormat":"{{region}} / {{partition}} · {{node_id}}","datasource":{"type":"prometheus","uid":"oracache-prometheus"},"instant":false,"range":true}
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Оценка отставания follower",
      "description": "Commit наблюдаемого лидера минус applied follower той же группы. При неизвестном или неоднозначном лидере серия отсутствует.",
      "gridPos": {"x":0,"y":73,"w":12,"h":7},
      "datasource": {"type":"prometheus","uid":"oracache-prometheus"},
      "fieldConfig": {"defaults":{"unit":"short","noValue":"Нет данных","custom":{"spanNulls":false}},"overrides":[]},
      "options": {"legend":{"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}},
